generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Produto {
  id              Int      @id @default(autoincrement())
  nome            String
  marca           String
  categoria       String
  descricao       String?
  preco           Float?
  imagem          String?
  linkAfiliado    String?
  videoOficial    String?

  destaques       String?
  fichaTecnica    String?
  pontosPositivos String?
  pontosAtencao   String?

  criadoEm        DateTime @default(now())
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())
}